      )
    }
    PublicShellNavigate(path) -> {
      public_mount_navigate(
        config: config,
        model: model,
        path: path,
        push_history: True,
      )
    }
    PublicBrowserPathChanged(path) -> {
      public_mount_navigate(
        config: config,
        model: model,
        path: path,
        push_history: False,
