#!/usr/bin/env bash
# On-demand unified authorization codegen compile check. Not part of `gleam test`.
#
# This checks the Rally Scoreboard style path: Proute mounts, page shared state,
# page-local load/save contracts, and the generated admin WebSocket auth gate.
set -euo pipefail

RALLY_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP_DIR="$RALLY_ROOT/tmp/auth_check_$$"

cleanup() {
  if [ "${KEEP_AUTH_CHECK:-}" != "1" ]; then
    rm -rf "$APP_DIR"
  else
    echo "Keeping $APP_DIR for debugging"
  fi
}
trap cleanup EXIT

echo "=== Rally unified auth codegen check ==="

mkdir -p \
  "$APP_DIR/src/admin/pages" \
  "$APP_DIR/src/public/pages" \
  "$APP_DIR/test"

cat > "$APP_DIR/gleam.toml" <<TOML
name = "auth_check"
version = "0.1.0"
target = "erlang"

[dependencies]
gleam_erlang = ">= 1.0.0 and < 2.0.0"
gleam_http = ">= 4.0.0 and < 5.0.0"
gleam_stdlib = ">= 0.60.0 and < 2.0.0"
libero = { path = "$RALLY_ROOT/../libero-gleam" }
lustre = ">= 5.7.0 and < 6.0.0"
mist = ">= 6.0.0 and < 7.0.0"
rally = { path = "$RALLY_ROOT" }
sqlight = ">= 1.0.0 and < 2.0.0"

[dev-dependencies]
gleeunit = ">= 1.0.0 and < 2.0.0"
proute = { path = "$RALLY_ROOT/../proute" }

[tools.rally.context]
module = "sqlight"
type = "Connection"
TOML

cat > "$APP_DIR/proute.toml" <<'TOML'
[proute]
pages_root = "src"

[[proute.mounts]]
name = "admin"
route_root = "/admin"

[[proute.mounts]]
name = "public"
route_root = "/"
TOML

cat > "$APP_DIR/src/admin/page_shared_state.gleam" <<'GLEAM'
pub type AdminPageSharedState {
  AdminPageSharedState
}
GLEAM

cat > "$APP_DIR/src/public/page_shared_state.gleam" <<'GLEAM'
pub type PublicPageSharedState {
  PublicPageSharedState
}
GLEAM

cat > "$APP_DIR/src/admin/pages/dashboard.gleam" <<'GLEAM'
import admin/page_shared_state.{type AdminPageSharedState}
import generated/proute/admin/page_input
import gleam/int
import lustre/effect.{type Effect, none}
import lustre/element.{type Element}
import lustre/element/html
import rally/runtime/load as runtime_load

@target(erlang)
import sqlight

pub type Model {
  Model(count: Int)
}

pub type Message {
  NoOp
  Loaded(Result(Int, runtime_load.LoadError))
}

pub type ServerMsg {
  AdminDashboardLoad
  AdminDashboardIncrement
}

pub type LoadResult {
  AdminDashboardLoaded(count: Int)
}

pub type GameUpdate {
  GameUpdate(count: Int)
}

pub type SaveError {
  SaveError(message: String)
}

pub fn initial_model(
  _page_shared_state: AdminPageSharedState,
  _query_params: page_input.QueryParams,
) -> Model {
  Model(count: 0)
}

pub fn update(model: Model, msg: Message) -> #(Model, Effect(Message)) {
  case msg {
    NoOp -> #(model, none())
    Loaded(Ok(count)) -> #(Model(count:), none())
    Loaded(Error(_)) -> #(model, none())
  }
}

pub fn view(model: Model) -> Element(Message) {
  html.text("admin " <> int.to_string(model.count))
}

@target(erlang)
pub fn load(
  _db: sqlight.Connection,
) -> Result(Int, runtime_load.LoadError) {
  Ok(0)
}

@target(erlang)
pub fn handle(
  _db: sqlight.Connection,
  message: ServerMsg,
) -> Result(GameUpdate, SaveError) {
  case message {
    AdminDashboardLoad ->
      Error(SaveError(message: "Load is not a save action."))
    AdminDashboardIncrement -> Ok(GameUpdate(count: 1))
  }
}
GLEAM

cat > "$APP_DIR/src/admin/pages/home_.gleam" <<'GLEAM'
import admin/page_shared_state.{type AdminPageSharedState}
import generated/proute/admin/page_input
import lustre/effect.{type Effect, none}
import lustre/element.{type Element}
import lustre/element/html

pub type Model {
  Model
}

pub type Message {
  NoOp
}

pub fn initial_model(
  _page_shared_state: AdminPageSharedState,
  _query_params: page_input.QueryParams,
) -> Model {
  Model
}

pub fn update(model: Model, _msg: Message) -> #(Model, Effect(Message)) {
  #(model, none())
}

pub fn view(_model: Model) -> Element(Message) {
  html.text("admin home")
}
GLEAM

cat > "$APP_DIR/src/admin/pages/not_found_.gleam" <<'GLEAM'
import admin/page_shared_state.{type AdminPageSharedState}
import generated/proute/admin/page_input
import lustre/effect.{type Effect, none}
import lustre/element.{type Element}
import lustre/element/html

pub type Model {
  Model
}

pub type Message {
  NoOp
}

pub fn initial_model(
  _page_shared_state: AdminPageSharedState,
  _query_params: page_input.QueryParams,
) -> Model {
  Model
}

pub fn update(model: Model, _msg: Message) -> #(Model, Effect(Message)) {
  #(model, none())
}

pub fn view(_model: Model) -> Element(Message) {
  html.text("not found")
}
GLEAM

cat > "$APP_DIR/src/public/pages/home_.gleam" <<'GLEAM'
import generated/proute/public/page_input
import lustre/effect.{type Effect, none}
import lustre/element.{type Element}
import lustre/element/html
import public/page_shared_state.{type PublicPageSharedState}

pub type Model {
  Model
}

pub type Message {
  NoOp
}

pub fn initial_model(
  _page_shared_state: PublicPageSharedState,
  _query_params: page_input.QueryParams,
) -> Model {
  Model
}

pub fn update(model: Model, _msg: Message) -> #(Model, Effect(Message)) {
  #(model, none())
}

pub fn view(_model: Model) -> Element(Message) {
  html.text("public home")
}
GLEAM

cat > "$APP_DIR/src/public/pages/not_found_.gleam" <<'GLEAM'
import generated/proute/public/page_input
import lustre/effect.{type Effect, none}
import lustre/element.{type Element}
import lustre/element/html
import public/page_shared_state.{type PublicPageSharedState}

pub type Model {
  Model
}

pub type Message {
  NoOp
}

pub fn initial_model(
  _page_shared_state: PublicPageSharedState,
  _query_params: page_input.QueryParams,
) -> Model {
  Model
}

pub fn update(model: Model, _msg: Message) -> #(Model, Effect(Message)) {
  #(model, none())
}

pub fn view(_model: Model) -> Element(Message) {
  html.text("not found")
}
GLEAM

cat > "$APP_DIR/test/auth_check_test.gleam" <<'GLEAM'
import gleeunit
import gleeunit/should

pub fn main() {
  gleeunit.main()
}

pub fn dummy_test() {
  1 |> should.equal(1)
}
GLEAM

cd "$APP_DIR"
echo "Running unified generation..."
gleam run -m rally gen >/dev/null

echo "Building Erlang target..."
gleam build --target erlang >/dev/null

echo "Checking generated admin auth gate..."
grep -Fq "admin_auth: fn(state) -> Option(admin_auth)" src/generated/rally/server_ws.gleam
grep -Fq 'Error([runtime_load.LoadError(message: "Unauthorized.")])' src/generated/rally/server_ws.gleam
grep -Fq 'Error([SaveError(field: None, message: "Unauthorized.")])' src/generated/rally/server_ws.gleam

if {
  find src -path src/generated -prune -o -type f -print
  printf '%s\n' gleam.toml proute.toml
} | xargs grep \
  -e '\[\[tools\.rally\.clients\]\]' \
  -e 'server''_context' \
  -e 'shell\.html' \
  -e 'server_' >/dev/null
then
  echo "Retired client-generation shape leaked into auth check fixture" >&2
  exit 1
fi

echo "PASS: unified auth gate codegen produces compilable output"
